# =
# FoundIt Environment Configuration Example
# Copy this file to .env or .env.local and populate the values.
# NEVER commit real production secrets into source control.
# =

# --- Google OAuth Configuration ---
# 1. Obtain a Client ID from Google Cloud Console:
#    APIs & Services > Credentials > Create Credentials > OAuth client ID > Web application
# 2. Authorized JavaScript origins: http://localhost:3000, http://127.0.0.1:3000
# 3. For Google Identity Services (GIS) ID-token flow, only the Client ID is required (no secret needed!).
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Optional: Only needed if implementing Google OAuth 2.0 Authorization Code flow with server-side token exchange
GOOGLE_CLIENT_SECRET=

# --- Server & Session Configuration ---
# Port for the secure Express authentication backend
PORT=

# Public URL of the application
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# Node environment: 'development' or 'production'
NODE_ENV=

# --- AI Studio / Gemini API Configuration ---
# Required for Gemini AI API calls if using server-side / client-side AI capabilities.
GEMINI_API_KEY=

# --- Supabase Configuration (application database + item image storage) ---
# 1. Create a project at https://supabase.com (Settings > API).
# 2. SUPABASE_URL / ANON key are PUBLIC (Row Level Security protects the data).
# 3. SUPABASE_SERVICE_ROLE_KEY is SECRET and server-side only — it bypasses RLS.
#    NEVER prefix it with VITE_ and NEVER import it into frontend code.
# 4. Run supabase/schema.sql in the Supabase SQL Editor to create tables,
#    RLS policies, and the item-images storage bucket.
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
